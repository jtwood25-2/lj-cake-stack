{
  // Deployed as https://cake.<your-subdomain>.workers.dev
  "name": "cake",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Static files (the game and the admin page) are served straight from ./public;
  // anything not found there, including /api/*, reaches the worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cake-stack",
      // Created 2026-11-03 with `wrangler d1 create cake-stack`.
      "database_id": "c5863298-daea-4dbd-b4a0-fc3a2ece0c07"
    }
  ],
  "observability": { "enabled": true }
}
